# GEMINI_API_KEY: Required for Gemini AI API calls (+HR AI Assistant & Analytics).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Default Development Database (SQLite — automatically creates plushr.db & seeds demo accounts)
DB_MODE="sqlite"
# Railway SQLite volume: mount /data and set SQLITE_DB_PATH=/data/plushr.db
SQLITE_DB_PATH="plushr.db"

# Optional MySQL Configuration (only used if DB_MODE="mysql" and DB_HOST is provided)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME="plushr_db"

# Auth / JWT Secrets (set strong random strings in production; auto-generated in memory for dev)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Optional Email Service (not required in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="noreply@plushr.ma"

# Demo mode controls (set to false in production)
ENABLE_DEMO_ACCOUNTS="true"

# One-time production recovery. Set the email and password only in the service's runtime variables.
SUPER_ADMIN_RECOVERY_ENABLED=false
# SUPER_ADMIN_RECOVERY_EMAIL=
# SUPER_ADMIN_RECOVERY_PASSWORD=
